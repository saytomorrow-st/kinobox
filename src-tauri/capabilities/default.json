{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Команды приложения для окон входа и главного окна. Из системных прав только перетаскивание своего окна за заголовок.",
  "windows": ["login", "main", "player", "player-controls"],
  "permissions": [
    "allow-boot",
    "allow-login",
    "allow-logout",
    "allow-session",
    "allow-mirrors",
    "allow-check-mirrors",
    "allow-add-mirror",
    "allow-select-mirror",
    "allow-quit",
    "allow-catalog",
    "allow-search",
    "allow-details",
    "allow-episodes",
    "allow-streams",
    "allow-player-load",
    "allow-player-play",
    "allow-player-pause",
    "allow-player-seek",
    "allow-player-set-quality",
    "allow-player-set-volume",
    "allow-player-stop",
    "allow-player-qualities",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
